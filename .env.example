# Public canonical origin. Keep this production value unless intentionally deploying another site.
SITE_URL=https://central-asia.live

# Required server-only content origin (without /api). No credentials in URLs.
# Local/staging: point to your own backend, not production.
CONTENT_API_URL=
CONTENT_API_TIMEOUT_MS=10000

# Legacy public IMAGE/ASSET origin, NOT backend API configuration. Never put secrets here.
NEXT_PUBLIC_URL=https://central-asia.live
NEXT_PUBLIC_PHONE_NUMBER=
NEXT_PUBLIC_EMAIL=
GOOGLE_ANALYTICS_ID=
GOOGLE_MAPS_API_KEY=

# NextAuth: create a fresh high-entropy secret in your secret manager; never commit it.
# Use HTTPS in production. HTTP is permitted only for development.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# Optional single-IP header overwritten by trusted ingress. See ADMIN.md.
# Leave empty until direct access to Next.js is restricted.
ADMIN_TRUSTED_IP_HEADER=
# Admin MongoDB (existing users collection with bcrypt password hashes).
# Prefer an authenticated TLS URI from your secret manager for production.
ADMIN_MONGODB_URI=
# Legacy local connector, used only if ADMIN_MONGODB_URI is empty:
DB_HOST=127.0.0.1
DB_PORT=27017
DB_NAME=

# Optional reliable contact inbox, stored durably in MongoDB (see CONTACT.md).
# Disabled, with explicit 503 feedback, until ALL required values are configured.
CONTACT_MONGODB_URI=
CONTACT_MONGODB_DATABASE=
CONTACT_ORIGIN=http://localhost:3000
CONTACT_RATE_LIMIT_SECRET=
# Optional header containing ONE IP, overwritten by your trusted reverse proxy.
# Leave empty unless untrusted callers cannot reach the app directly.
CONTACT_TRUSTED_IP_HEADER=
