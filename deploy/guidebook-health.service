[Unit]
Description=Sample GuideBook VPS health metrics and emit threshold alerts
After=network.target mongod.service nginx.service pm2-root.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0027
ExecStart=/usr/local/sbin/guidebook-health.py check
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/guidebook-health /var/log/guidebook-health
ReadOnlyPaths=/var/log/nginx /var/lib/mongodb
PrivateTmp=true
